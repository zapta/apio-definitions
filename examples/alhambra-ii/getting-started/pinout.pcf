# This file maps the signal names used in main.v to FPGA pin
# numbers. It lists only the signals this example uses.

# ------------ System clock (12MHz) -------------------------------------------
set_io sys_clk 49  # input

# ------------ User Leds ------------------------------------------------------
set_io leds[0] 37  # output, LED7 on the board
set_io leds[1] 38  # output, LED6 on the board
